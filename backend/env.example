# Server config
PORT=5000

# MongoDB config
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# JWT config
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=development
JWT_EXPIRE=5d

# Cookie config
COOKIE_EXPIRE=5
COOKIE_SECRET=hutech-event-secret

# Cloudinary config
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MAX_FILE_SIZE=100485760  # 10MB in bytes
MAX_FILE_UPLOAD=5000000

# Email config (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SERVICE=gmail
SMTP_MAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_NAME=HUTECH Event Management
FROM_EMAIL=noreply@hutech.edu.vn

# Frontend config
FRONTEND_URL=http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# Email Debug (set to true for development)
EMAIL_DEBUG=true 